# Submissions (/submit). Without APIFY_TOKEN + GITHUB_TOKEN they stay closed.
# Free mode (default): anyone can submit, no Stripe needed.
SUBMISSIONS_FREE=true
SUBMISSION_IP_HOURLY=3
SUBMISSION_MIN_FOLLOWERS=1000
SUBMISSION_MAX_LIVE=300
LIVE_REVALIDATE_SECONDS=30
# paid mode: open review PRs before new submissions pause
SUBMISSION_QUEUE_LIMIT=40

# Paid mode (SUBMISSIONS_FREE=false) only
SITE_URL=https://your-domain.example
SUBMISSION_PRICE_CENTS=4900
SUBMISSION_CURRENCY=usd

# Stripe Checkout + webhook, paid mode only (endpoint: <SITE_URL>/api/stripe/webhook/ , event checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Instagram data through Apify actors
APIFY_TOKEN=
APIFY_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_POSTS_ACTOR=apify~instagram-post-scraper
SUBMISSION_POSTS_LIMIT=60

# Review queue: a token that can push branches and open pull requests
GITHUB_TOKEN=
GITHUB_REPO=tiredknifeed/AI-Celebrity-Index
# Empty = the repository default branch
GITHUB_BASE_BRANCH=

# Waitlist (/waitlist/; stored privately in Netlify Blobs, no key needed).
# The X account defaults to AIFameIndex. NEXT_PUBLIC_X_POST is the post people
# like and repost; until it is set those tasks open the profile. Public values,
# baked in at build time: redeploy after changing them.
NEXT_PUBLIC_X_HANDLE=AIFameIndex
NEXT_PUBLIC_X_POST=
